# Requestly — Environment Configuration Example
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or real credentials to Git.

# ── MongoDB Atlas ────────────────────────────────────────────────────
# Connection string from MongoDB Atlas → Connect → Drivers
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=

# Application database name inside the cluster
MONGODB_DATABASE=requestly
